# ─── General ────────────────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. Se usa en metadatos y correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Solo desarrollo local: datos en memoria y WhatsApp/correo por consola.
# Se ignora en Vercel. Déjalo vacío cuando configures Supabase.
DEMO_MODE=true

# ─── Supabase (Project Settings → API) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreta: solo servidor. Nunca le pongas prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── WhatsApp Business Cloud API (Meta) ─────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_CLIENTE=solicitud_en_curso
WHATSAPP_TEMPLATE_ABOGADO=aviso_nueva_solicitud
WHATSAPP_TEMPLATE_LANG=es

# ─── Correo (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
# Debe ser de un dominio verificado en Resend
EMAIL_FROM=Soluciones Migratorias <no-responder@solucionmigratoria.cl>

# ─── Anti-spam (opcional: sin estas claves queda solo honeypot + rate limit) ─
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sal para guardar las IP solo como hash en el rate limit. Genera una cadena larga al azar.
RATE_LIMIT_SALT=
